NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Generate a random secret of at least 32 characters for production.
JWT_SECRET=
TOKEN_TTL=30d
DB_PATH=./data/finance.db
# Production requires the exact web app origin, without a trailing slash.
CORS_ORIGINS=
# Optional existing account to grant admin access on API startup.
ADMIN_EMAIL=
# SMTP settings used to deliver one-time password reset links. Admin-generated
# reset links only need PASSWORD_RESET_URL, so they still work if SMTP is down.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=https://your-vercel-domain.example/reset-password
