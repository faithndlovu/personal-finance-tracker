NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Generate a random secret of at least 32 characters for production.
JWT_SECRET=
TOKEN_TTL=30d
DB_PATH=./data/finance.db
# Production requires the exact web app origin, without a trailing slash.
CORS_ORIGINS=
# Optional existing account to grant admin access on API startup.
ADMIN_EMAIL=
